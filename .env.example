# Copy to .env (which is git-ignored) and fill in. Never commit real values.

# LLM - free key from https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# MLflow tracking server
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Airflow 3 API (the password is also used by scripts/start_airflow.sh to create the user)
AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=
AIRFLOW_APPROVED_DAGS=training_pipeline

# Kubernetes - the agent is confined to this context and namespace
K8S_CONTEXT=kind-mlops
K8S_NAMESPACE=mlops
K8S_APPROVED_DEPLOYMENTS=prediction-api
